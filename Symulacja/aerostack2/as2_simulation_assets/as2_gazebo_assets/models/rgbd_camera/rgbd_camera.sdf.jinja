   {% if sensor.model == 'gimbal_speed' or sensor.model == 'gimbal_position' -%}

    <model name='{{ sensor.sensor_attached }}'>

{% else -%}

    <model name='{{ sensor.name }}'>
    <pose
        relative_to="base_link">
        {{ sensor.pose }}
    </pose>

{% endif -%}
        <link name="rgbd_camera">
            <inertial>
                <mass>0.005</mass>
                <inertia>
                    <ixx>8.33e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>8.33e-06</iyy>
                    <iyz>0</iyz>
                    <izz>8.33e-06</izz>
                </inertia>
            </inertial>
            <sensor name="rgbd_camera" type="rgbd_camera">
                <always_on>1</always_on>
                <!-- Halved from 20 Hz. This sensor renders colour, depth and a point cloud on
                     every tick, so it costs roughly three passes per frame. -->
                <update_rate>10</update_rate>
                <camera name="rgbd_camera">
                    <horizontal_fov>1.0472</horizontal_fov>
                    <lens>
                        <intrinsics>
                            <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
                            <fx>554.3</fx>
                            <fy>554.3</fy>
                            <!-- cx = ( width + 1 ) / 2 -->
                            <cx>320.5</cx>
                            <!-- cy = ( height + 1 ) / 2 -->
                            <cy>240.5</cy>
                            <s>0</s>
                        </intrinsics>
                    </lens>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>300</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>0.1</near>
                            <far>10</far>
                        </clip>
                    </depth_camera>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.007</stddev>
                    </noise>

                <!-- Gazebo Fortress stamps the point cloud with this frame id but keeps the
                     XYZ data in the Gazebo camera convention (+X forward, +Z up), not in the
                     ROS optical one (+Z forward, +Y down). Pointing it at the sensor link frame
                     therefore keeps the cloud consistent with the data; the ROS optical frame is
                     still published as a child of that link for anything that needs it. -->
                {% if sensor.model == 'gimbal_speed' or sensor.model == 'gimbal_position' -%}

                    <optical_frame_id>/{{ namespace }}/{{ sensor.name }}/_0/_1/_2/{{ sensor.sensor_attached }}/{{ sensor.sensor_attached_type }}</optical_frame_id>

                {% else -%}

                    <optical_frame_id>/{{ namespace }}/{{ sensor.name }}/{{ sensor.model }}</optical_frame_id>

                {% endif -%}

              </camera>
            </sensor>
        </link>
        <frame name="mount_point"/>
    </model>

{% if sensor.model != 'gimbal_speed' and sensor.model != 'gimbal_position' -%}

<joint
    name="{{ sensor.name }}_joint" type="fixed">
    <parent>base_link</parent>
    <child>{{ sensor.name }}</child>
</joint>

{% endif -%}
