<?xml version="1.0" ?>
<sdf version="1.6">
    <model name="collapsed_industrial">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <geometry>
                    <mesh>
                        <uri>model://collapsed_industrial_building/meshes/collapsed_industrial.dae</uri>
                    </mesh>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://collapsed_industrial_building/meshes/collapsed_industrial.dae</uri>
                    </mesh>
                </geometry>
                <!-- 294 K (21 C): sheet metal and concrete, cooler than the masonry across
                     the site because most of this shell is in its own shadow. -->
                <plugin
                    filename="ignition-gazebo-thermal-system"
                    name="ignition::gazebo::systems::Thermal">
                    <temperature>294.0</temperature>
                </plugin>
            </visual>
        </link>
    </model>
</sdf>
