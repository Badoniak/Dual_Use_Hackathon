<?xml version="1.0"?>

<model>
  <name>Thermal Camera</name>
  <version>1.0</version>
  <sdf version="1.9">thermal_camera.sdf</sdf>

  <description>
    Thermal (LWIR) camera, 640x512, 60 deg HFOV, 10 Hz. Emits a 16 bit image where
    each count is 0.01 K, covering 253.15 K to 673.15 K.
  </description>
</model>
