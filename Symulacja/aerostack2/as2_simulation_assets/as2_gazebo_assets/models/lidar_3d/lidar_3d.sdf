<?xml version="1.0"?>
<sdf version="1.9">
    <model name="lidar_3d">
        <link name="lidar_3d">
            <inertial>
                <mass>0.005</mass>
                <inertia>
                    <ixx>8.33e-06</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>8.33e-06</iyy>
                    <iyz>0</iyz>
                    <izz>8.33e-06</izz>
                </inertia>
            </inertial>
            <sensor name="gpu_ray" type="gpu_ray">
                <!-- 900 samples at 5 Hz is 72k rays/s, against 288k for the original
                     1800 at 10 Hz. Angular resolution is still 0.4 deg, which is finer than
                     a real 16 beam unit, and the GPU cost drops by a factor of four. -->
                <update_rate>5</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>900</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>16</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.261799</min_angle>
                            <max_angle>0.261799</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.05</min>
                        <max>100</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </link>
        <frame name="mount_point"/>
    </model>
</sdf>
