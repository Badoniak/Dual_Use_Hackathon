<?xml version="1.0"?>

<model>
  <name>Microphone</name>
  <version>1.0</version>
  <sdf version="1.9">microphone.sdf</sdf>

  <description>
    Mount point for a simulated microphone. Gazebo has no acoustic sensor, so this model
    only carries the link (and therefore the tf frame); the audio itself is synthesised by
    the as2_gazebo_assets microphone_node from the sound sources listed in its config.
  </description>
</model>
