<?xml version="1.0"?>
<sdf version="1.9">
    <!-- Gazebo Fortress has no acoustic sensor, so this model carries no <sensor>. The link
         exists to give the microphone a pose on the drone, and therefore a tf frame
         (<drone>/<name>/microphone) that microphone_node reads to place the capsules in the
         world. The waveform itself is synthesised by that node. -->
    <model name="microphone">
        <link name="microphone">
            <inertial>
                <mass>0.002</mass>
                <inertia>
                    <ixx>1.0e-07</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1.0e-07</iyy>
                    <iyz>0</iyz>
                    <izz>1.0e-07</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.008</radius>
                        <length>0.004</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0.1 0.1 0.1 1</diffuse>
                </material>
            </visual>
        </link>
        <frame name="mount_point"/>
    </model>
</sdf>
