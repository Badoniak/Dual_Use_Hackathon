#!/usr/bin/env python3
"""
Archive every simulated sensor to standalone files, one directory per sensor.

Nothing here depends on ROS tooling to read back: images are PNG, point clouds are PCD and
PLY, scalar sensors are CSV, GPS is CSV plus GPX, audio is WAV. Each sensor directory also
carries an index.csv that pairs every file with its timestamp and the sensor pose in the world
frame, which is what lets an external application drop the data onto a shared 3D map.

Streams, their formats and their write rates come from a YAML config (see
config/sensor_recorder.yaml).
"""

__authors__ = 'Generated for the disaster_site simulation'
__license__ = 'BSD-3-Clause'

